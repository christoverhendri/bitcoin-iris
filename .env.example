# Server-side only. The worker is local; these are not browser/public variables.
IRIS_SENTIMENT_URL=http://127.0.0.1:8765
IRIS_SENTIMENT_PROFILE=challenger
# Node.js worker limits (per process; no browser inference).
IRIS_SENTIMENT_CONCURRENCY=1
IRIS_SENTIMENT_BATCH_SIZE=8
IRIS_SENTIMENT_MAX_QUEUE=128
IRIS_SENTIMENT_THREADS=4
IRIS_SENTIMENT_CACHE_SIZE=2048
IRIS_SENTIMENT_CACHE_TTL_MS=3600000
IRIS_SENTIMENT_QUEUE_TIMEOUT_MS=10000
