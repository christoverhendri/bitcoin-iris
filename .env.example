# Salin ke .env.local. Semua opsional: tanpa key apa pun dashboard tetap jalan,
# panel yang sumbernya belum tersedia tampil dengan badge MOCK.

# --- Supabase (dibutuhkan untuk sinyal model dari tabel clf_signals & whale_events)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Hanya server-side. Jangan pernah diberi prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Dev lokal TANPA Supabase: baca sinyal model mingguan dari file output worker.
# Diabaikan kalau Supabase dikonfigurasi.
CLF_LOCAL_SIGNAL_FILE=worker/out/clf_signal_latest.json
# Sama, untuk sentimen sosial Santiment (ditulis job worker social_sentiment).
SOCIAL_SENTIMENT_LOCAL_FILE=worker/out/social_sentiment.json

# --- API keys (gratis, daftar sendiri)
FRED_API_KEY=
COINGECKO_API_KEY=
WHALE_ALERT_API_KEY=
ARKHAM_API_KEY=

# --- Bearer untuk POST /api/ingest/whale (string acak panjang; sama dengan CRON_SECRET di worker/.env)
CRON_SECRET=
