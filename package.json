{
  "name": "iris-terminal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:sentiment": "node scripts/sentiment-dev.mjs",
    "start:sentiment": "node scripts/sentiment-dev.mjs --production",
    "sentiment:serve": "node scripts/sentiment-dev.mjs --worker-only",
    "sentiment:test": "node --test services/sentiment-node/node/tests/*.test.mjs services/sentiment-node/node/parser.test.mjs",
    "sentiment:validate": "node services/sentiment-node/node/verify.mjs",
    "sentiment:test:http": "node services/sentiment-node/node/http-test.mjs",
    "sentiment:check": "npm run sentiment:test && npm run sentiment:validate && npm run sentiment:test:http",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:registry": "node scripts/verify-registry.mjs"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "@supabase/supabase-js": "^2.114.0",
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "lightweight-charts": "^5.2.1",
    "next": "16.3.4",
    "nuqs": "^2.10.1",
    "onnxruntime-node": "1.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-shape": "^3.2.0",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
