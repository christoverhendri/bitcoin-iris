# Supabase (Service Role required for worker writes)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=

# Classifier paths & freshness guards
CLF_DATA_DIR=worker/data/clf
CLF_MODEL_DIR=worker/models/clf_7d
CLF_MAX_DATA_LAG_DAYS=3
CLF_MAX_NAN=0

# Scheduler cron (UTC) — Default: Monday 00:30 UTC
CLF_CRON=30 0 * * 1
