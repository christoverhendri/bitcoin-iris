# Salin ke worker/.env. Worker juga membaca ../.env.local kalau ada.

# --- Supabase (service role, hanya worker yang menulis). Kosong = sinyal hanya ditulis
# ke worker/out/clf_signal_latest.json untuk dashboard lokal.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- API keys input model
# FRED: wajib untuk 12 kolom makro (CPI, PCE, PPI, NFP, UNRATE, AHE, retail, GDP,
# FOMC upper/lower, dollar index DTWEXBGS, M2). Tanpa ini kolom tsb dibekukan di nilai terakhir.
FRED_API_KEY=
# CoinGecko demo key: opsional (tanpa key tetap jalan, rate-limit lebih ketat).
COINGECKO_API_KEY=
# Santiment (app.santiment.net -> Account -> API keys): sentimen sosial BTC harian.
# Kosong = job social_sentiment tidak dijadwalkan. Akun gratis: 1000 request/bulan,
# 30 hari terakhir disembunyikan.
SANTIMENT_API_KEY=

# --- Path (default sudah benar untuk repo ini)
CLF_DATA_DIR=data/clf
CLF_SEED_DIR=data/seed
CLF_STATE_DIR=data/state
CLF_MODEL_DIR=models/clf_7d
CLF_SIGNAL_OUT=out/clf_signal_latest.json
SOCIAL_SENTIMENT_OUT=out/social_sentiment.json
SOCIAL_SENTIMENT_DAYS=30

# --- Penjaga kesegaran
CLF_MAX_DATA_LAG_DAYS=3
CLF_MAX_NAN=0

# --- Jadwal (cron 5-field standar, UTC; 1 = Senin)
REFRESH_CRON=15 0 * * *
CLF_CRON=30 0 * * 1
SOCIAL_CRON=20 0 * * *
WHALE_CRON=*/5 * * * *

# --- Pemicu whale ingest (route Next.js). Kosong = job whale tidak dijadwalkan.
IRIS_APP_URL=http://localhost:3000
CRON_SECRET=
