# Optional. Copy to .env.local inside terminal/; leave unused settings blank.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alternative: NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only optional provider credentials
COINGECKO_API_KEY=
FRED_API_KEY=
ARKHAM_API_KEY=
WHALE_ALERT_API_KEY=

# Only needed for optional whale ingestion. Apply supabase/migrations first.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Optional server-only validated 30-day research forecast artifact. When set,
# an unreadable, stale, or invalid file renders as unavailable (never mock data).
IRIS_FORECAST_PATH=

# Optional directory containing canonical coinbase_hourly.sqlite / coinbase_minute.sqlite.
# Defaults to ../artifacts/market relative to terminal/. Server-side only.
IRIS_MARKET_ARCHIVE_DIR=

# Optional Coinbase BTC-USD execution ledger; defaults to ../artifacts/market/coinbase_trades.sqlite.
IRIS_TRADE_LEDGER_PATH=
